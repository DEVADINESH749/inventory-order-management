        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}},\n  \"shipping_address\": \"Chennai, Tamil Nadu, India\",\n  \"items\": [\n    {\n      \"product_id\": {{product_id}},\n      \"product_name\": \"Wireless Bluetooth Headphones\",\n      \"price\": 2299,\n      \"quantity\": 1\n    }\n  ],\n  \"discount_amount\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/orders/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Order create is successful', function () { pm.expect([200,201]).to.include(pm.response.code); });",
                  "const body = pm.response.json();",
                  "if (body.id) pm.collectionVariables.set('order_id', String(body.id));"
                ]
              }
