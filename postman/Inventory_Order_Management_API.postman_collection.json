                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Mouse\",\n  \"description\": \"Test product created from Postman\",\n  \"category\": \"Electronics\",\n  \"price\": 999,\n  \"image_url\": \"https://example.com/mouse.jpg\",\n  \"sku\": \"POSTMAN-MOUSE-001\",\n  \"is_active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/products/products"
          }
        }
